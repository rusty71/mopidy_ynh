#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICES
#=================================================
ynh_script_progression "Stopping $app's systemd services..."

# Older installations ran a separate publisher; it has to be gone before
# Mopidy starts publishing by itself, or both would fight over the mount.
if [ -f /etc/systemd/system/mopidy-publisher.service ]; then
    ynh_systemctl --service="mopidy-publisher" --action="stop"
fi
ynh_systemctl --service="$app" --action="stop"

#=================================================
# UPDATE THE SETTINGS FROM THE EXISTING CONFIGURATION
#=================================================
# The credentials live in the configuration file of Mopidy, not in the
# answers of the install questions: read them from there, so that an
# upgrade does not wipe them.
_mopidy_load_config_vars || true

# Every variable of the templates has to exist, even when the configuration
# file is gone.
hide_volume="$(ynh_app_setting_get --key=hide_volume)"
hide_volume="${hide_volume:-true}"
streams_url="$(_mopidy_streams_url)"
qobuz_email="${qobuz_email:-}"
qobuz_auth_token="${qobuz_auth_token:-}"
qobuz_app_id="${qobuz_app_id:-}"
qobuz_secret="${qobuz_secret:-}"
qobuz_quality="${qobuz_quality:-6}"
icecast_host="${icecast_host:-127.0.0.1}"
icecast_port="${icecast_port:-8000}"
icecast_password="${icecast_password:-}"
icecast_admin_user="$(_mopidy_icecast_admin_user)"
icecast_source_port="$(_mopidy_icecast_source_port)"
cache_enabled="${cache_enabled:-true}"
cache_dir="${cache_dir:-}"

ynh_app_setting_set --key=icecast_admin_user --value="$icecast_admin_user"
ynh_app_setting_set --key=icecast_source_port --value="$icecast_source_port"

# The lossless mount is gone, so there is no point in pulling hi-res from
# Qobuz anymore: the stream is 44.1 kHz MP3.
case "$qobuz_quality" in
    27|7)
        ynh_print_info "The stream is CD quality now; the Qobuz quality changes from $qobuz_quality to 6"
        qobuz_quality="6"
        ;;
esac

# The same normalisation as in the install script.
case "$cache_enabled" in
    1|true|True|TRUE|yes|on) cache_enabled="true" ;;
    *) cache_enabled="false" ;;
esac

#=================================================
# UPGRADE THE COMPONENTS
#=================================================
ynh_script_progression "Upgrading the Python environment..."

_mopidy_install_python

#=================================================
# UPDATE THE CONFIGURATION
#=================================================
ynh_script_progression "Updating $app's configuration..."

_mopidy_config
_mopidy_install_titles

# Remove what the publisher left behind.
if [ -f /etc/systemd/system/mopidy-publisher.service ]; then
    ynh_config_remove_systemd --service="mopidy-publisher"
fi
ynh_safe_rm "$install_dir/icecast-publisher.py"
ynh_safe_rm "$install_dir/run"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

if [ "$cache_enabled" = "true" ]; then
    mkdir -p "$cache_dir"
    chown -R "$app:" "$cache_dir"
fi

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Mopidy music server (Iris, Qobuz, Icecast stream)"

#=================================================
# SETUP SSOWAT
#=================================================
ynh_script_progression "Configuring domain-wide permissions..."

ynh_permission_url --permission="main" --add_url="$domain/mopidy/ws"
ynh_permission_url --permission="main" --add_url="$domain$path/iris"
ynh_permission_url --permission="main" --add_url="$domain$path/local"
# The album art of the local library is served under /local/, outside of the
# path of the app.
ynh_permission_url --permission="main" --add_url="$domain/local"

#=================================================
# START SYSTEMD SERVICES
#=================================================
ynh_script_progression "Starting $app's systemd services..."

ynh_systemctl --service="$app" --action="start" --log_path="systemd"

#=================================================
# SCAN THE LOCAL LIBRARY
#=================================================
ynh_script_progression "Scanning the local library..."

ynh_hide_warnings "$cmd_file" local scan || true

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
