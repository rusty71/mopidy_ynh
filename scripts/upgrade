#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICES
#=================================================
ynh_script_progression "Stopping $app's systemd services..."

ynh_systemctl --service="mopidy-publisher" --action="stop"
ynh_systemctl --service="$app" --action="stop"

#=================================================
# UPDATE THE SETTINGS FROM THE EXISTING CONFIGURATION
#=================================================
# The credentials live in the configuration file of Mopidy (and in the
# systemd unit of the publisher), not in the settings of the app: read them
# from there, so that an upgrade does not wipe them.
_mopidy_load_config_vars || true

# Every variable of the templates has to exist, even when the configuration
# file is gone.
qobuz_email="${qobuz_email:-}"
qobuz_auth_token="${qobuz_auth_token:-}"
qobuz_app_id="${qobuz_app_id:-}"
qobuz_secret="${qobuz_secret:-}"
qobuz_quality="${qobuz_quality:-27}"
icecast_host="${icecast_host:-127.0.0.1}"
icecast_port="${icecast_port:-8000}"
icecast_password="${icecast_password:-}"
icecast_admin_user="${icecast_admin_user:-admin}"
cache_enabled="${cache_enabled:-true}"
cache_dir="${cache_dir:-}"

# The same normalisation as in the install script.
case "$cache_enabled" in
    1|true|True|TRUE|yes|on) cache_enabled="true" ;;
    *) cache_enabled="false" ;;
esac

#=================================================
# UPGRADE THE COMPONENTS
#=================================================
ynh_script_progression "Upgrading the Python environment..."

_mopidy_install_python

#=================================================
# UPDATE THE CONFIGURATION
#=================================================
ynh_script_progression "Updating $app's configuration..."

_mopidy_config
_mopidy_deploy_publisher

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

if [ "$cache_enabled" = "true" ]; then
    mkdir -p "$cache_dir"
    chown -R "$app:" "$cache_dir"
fi

ynh_config_add_nginx

ynh_config_add_systemd
ynh_config_add_systemd --service="mopidy-publisher" --template="systemd-publisher.service"

yunohost service add "$app" --description="Mopidy music server (Iris, Qobuz, Icecast publisher)"

#=================================================
# START SYSTEMD SERVICES
#=================================================
ynh_script_progression "Starting $app's systemd services..."

ynh_systemctl --service="$app" --action="start" --log_path="systemd"
ynh_systemctl --service="mopidy-publisher" --action="start" --log_path="systemd"

#=================================================
# SCAN THE LOCAL LIBRARY
#=================================================
ynh_script_progression "Scanning the local library..."

ynh_hide_warnings "$cmd_file" local scan || true

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
