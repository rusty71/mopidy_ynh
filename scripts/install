#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# The optional questions may be left empty, but the variables have to exist:
# the templates are only rendered when every variable is set.
hide_volume="${hide_volume:-true}"
streams_url="$(_mopidy_streams_url)"
qobuz_email="${qobuz_email:-}"
qobuz_auth_token="${qobuz_auth_token:-}"
qobuz_app_id="${qobuz_app_id:-}"
qobuz_secret="${qobuz_secret:-}"
qobuz_quality="${qobuz_quality:-27}"
icecast_host="${icecast_host:-127.0.0.1}"
icecast_port="${icecast_port:-8000}"
icecast_password="${icecast_password:-}"
icecast_admin_user="${icecast_admin_user:-admin}"
cache_enabled="${cache_enabled:-true}"
cache_dir="${cache_dir:-}"

# YunoHost passes the answer to a boolean question as "1" or "0"; Mopidy
# wants "true" or "false".
case "$cache_enabled" in
    1|true|True|TRUE|yes|on) cache_enabled="true" ;;
    *) cache_enabled="false" ;;
esac

ynh_app_setting_set --key=qobuz_email --value="$qobuz_email"
ynh_app_setting_set --key=qobuz_auth_token --value="$qobuz_auth_token"
ynh_app_setting_set --key=qobuz_app_id --value="$qobuz_app_id"
ynh_app_setting_set --key=qobuz_secret --value="$qobuz_secret"
ynh_app_setting_set --key=qobuz_quality --value="$qobuz_quality"
ynh_app_setting_set --key=icecast_host --value="$icecast_host"
ynh_app_setting_set --key=icecast_port --value="$icecast_port"
ynh_app_setting_set --key=icecast_password --value="$icecast_password"
ynh_app_setting_set --key=icecast_admin_user --value="$icecast_admin_user"
ynh_app_setting_set --key=cache_enabled --value="$cache_enabled"
ynh_app_setting_set --key=cache_dir --value="$cache_dir"

#=================================================
# APP "BUILD" (DEPLOYING SOURCES, VENV, COMPILING ETC)
#=================================================
ynh_script_progression "Setting up the Python environment..."

_mopidy_install_python

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

_mopidy_config
_mopidy_deploy_publisher

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# The directory with the music of the users of the server.
ynh_multimedia_build_main_dir
mkdir -p "$media_dir"

# The albums that are downloaded from Qobuz end up here.
if [ "$cache_enabled" = "true" ]; then
    mkdir -p "$cache_dir"
    chown -R "$app:" "$cache_dir"
fi

# Create a dedicated NGINX config
ynh_config_add_nginx

# Create the systemd services
ynh_config_add_systemd
ynh_config_add_systemd --service="mopidy-publisher" --template="systemd-publisher.service"

yunohost service add "$app" --description="Mopidy music server (Iris, Qobuz, Icecast publisher)"

#=================================================
# SETUP SSOWAT
#=================================================
ynh_script_progression "Configuring domain-wide permissions..."

ynh_permission_url --permission="main" --add_url="$domain/mopidy/ws"
ynh_permission_url --permission="main" --add_url="$domain$path/iris"
ynh_permission_url --permission="main" --add_url="$domain$path/local"
# The album art of the local library is served under /local/, outside of the
# path of the app.
ynh_permission_url --permission="main" --add_url="$domain/local"

#=================================================
# PROVIDE ADDITIONAL SHELL COMMAND
#=================================================
ynh_script_progression "Provide additional shell command..."

ynh_config_add --template="../sources/extra_files/mopidyctl" --destination="$cmd_file"

chmod +x "$cmd_file"

#=================================================
# START SYSTEMD SERVICES
#=================================================
ynh_script_progression "Starting $app's systemd services..."

ynh_systemctl --service="$app" --action="start" --log_path="systemd"
ynh_systemctl --service="mopidy-publisher" --action="start" --log_path="systemd"

#=================================================
# SCAN THE LOCAL LIBRARY
#=================================================
ynh_script_progression "Scanning the local library..."

ynh_hide_warnings "$cmd_file" local scan || true

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
