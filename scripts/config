#!/bin/bash

# The restore and backup scripts can be run from a different directory (the
# restore runs from a work directory), so the common helpers are looked up
# where they are.
_common_script="$(dirname "$0")/_common.sh"
if [ ! -f "$_common_script" ]; then
    _common_script="/etc/yunohost/apps/$app/scripts/_common.sh"
fi
source "$_common_script"
source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# GETTERS
#=================================================

get__qobuz_email() {
    _mopidy_config_get username
}

get__qobuz_token() {
    # The token is a secret: it can be written, but not read back.
    echo ""
}

get__qobuz_app_id() {
    _mopidy_config_get app_id
}

get__qobuz_secret() {
    # The secret is a secret: it can be written, but not read back.
    echo ""
}

get__qobuz_quality() {
    _mopidy_config_get quality
}

get__icecast_host() {
    ynh_app_setting_get --key=icecast_host
}

get__icecast_port() {
    ynh_app_setting_get --key=icecast_port
}

get__icecast_password() {
    # The password is a secret: it can be written, but not read back.
    echo ""
}

get__icecast_admin_user() {
    _mopidy_titles_get username
}

get__streams_url() {
    sed -n 's/^set \$streams_url "\(.*\)";$/\1/p' \
        /etc/nginx/conf.d/"$domain".d/"$app".conf | head -1
}

set__streams_url() {
    if [ -z "$streams_url" ]; then
        ynh_print_info "The address of the streams was left unchanged"
        return
    fi

    ynh_print_info "The address of the streams is now $streams_url"

    sed -i "s|^set \$streams_url ".*";$|set \$streams_url \"$streams_url\";|" \
        /etc/nginx/conf.d/"$domain".d/"$app".conf

    ynh_systemctl --service=nginx --action=reload
}

get__hide_volume() {
    if grep -q "playback-controls section.volume { display: none" \
        "$install_dir/src/mopidy-iris/mopidy_iris/static/app.min.css" 2>/dev/null; then
        echo "true"
    else
        echo "false"
    fi
}

set__hide_volume() {
    ynh_app_setting_set --key=hide_volume --value="$hide_volume"
    ynh_print_info "Applying the volume setting of the interface..."
    _mopidy_patch_iris_frontend
    ynh_print_info "Reload the page of the interface to see the change"
}

get__cache_enabled() {
    _mopidy_config_get cache_enabled
}

get__cache_dir() {
    _mopidy_config_get cache_dir
}

#=================================================
# SETTERS
#=================================================

set__qobuz_email() {
    _mopidy_config_set username "$qobuz_email"
    ynh_app_setting_set --key=qobuz_email --value="$qobuz_email"
}

set__qobuz_token() {
    # An empty field means "keep the current token".
    if [ -n "$qobuz_token" ]; then
        _mopidy_config_set auth_token "$qobuz_token"
        ynh_app_setting_set --key=qobuz_auth_token --value="$qobuz_token"
    else
        ynh_print_info "The Qobuz auth token was left unchanged"
    fi
}

set__qobuz_app_id() {
    _mopidy_config_set app_id "$qobuz_app_id"
    ynh_app_setting_set --key=qobuz_app_id --value="$qobuz_app_id"
}

set__qobuz_secret() {
    if [ -n "$qobuz_secret" ]; then
        _mopidy_config_set secret "$qobuz_secret"
        ynh_app_setting_set --key=qobuz_secret --value="$qobuz_secret"
    else
        ynh_print_info "The Qobuz app secret was left unchanged"
    fi
}

set__qobuz_quality() {
    _mopidy_config_set quality "$qobuz_quality"
}

set__icecast_host() {
    ynh_app_setting_set --key=icecast_host --value="$icecast_host"
    _mopidy_streaming_set host "$icecast_host"
}

set__icecast_port() {
    ynh_app_setting_set --key=icecast_port --value="$icecast_port"

    local source_port
    source_port="$(_mopidy_icecast_source_port)"
    _mopidy_streaming_set source_port "$source_port"
}

set__icecast_password() {
    if [ -z "$icecast_password" ]; then
        ynh_print_info "The Icecast password was left unchanged"
        return
    fi

    ynh_app_setting_set --key=icecast_password --value="$icecast_password"
    _mopidy_streaming_set password "$icecast_password"
}

set__icecast_admin_user() {
    ynh_app_setting_set --key=icecast_admin_user --value="$icecast_admin_user"
    _mopidy_streaming_set username "$icecast_admin_user"
}

set__cache_enabled() {
    _mopidy_config_set cache_enabled "$cache_enabled"
}

set__cache_dir() {
    _mopidy_config_set cache_dir "$cache_dir"
    mkdir -p "$cache_dir"
    chown -R "$app:" "$cache_dir"
}

#=================================================
# HELPERS
#=================================================

_mopidy_titles_get() {
    # Read a key of the [icecast_titles] section.
    local key="$1"
    local file="$install_dir/$app.conf"

    sed -n '/^\[icecast_titles\]/,/^\[/p' "$file" \
        | grep -E "^[[:space:]]*${key}[[:space:]]*=" \
        | head -1 \
        | cut -d= -f2- \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

_mopidy_streaming_set() {
    # Change one of the source settings: the shout2send output line and the
    # [icecast_titles] section.
    local field="$1"
    local value="$2"
    local file="$install_dir/$app.conf"

    chmod 600 "$file"

    python3 - "$file" "$field" "$value" <<'PYTHON'
import re
import sys

path, field, value = sys.argv[1:4]
with open(path, encoding="utf-8") as handle:
    lines = handle.read().splitlines()

if field in ("host", "source_port", "password"):
    for index, line in enumerate(lines):
        if not line.startswith("output =") or "shout2send" not in line:
            continue
        if field == "host":
            line = re.sub(r"(\bip=)[^ ]+", r"\g<1>" + value, line)
        elif field == "source_port":
            line = re.sub(r"(\bport=)[^ ]+", r"\g<1>" + value, line)
        elif field == "password":
            line = re.sub(
                r'(\bpassword=)("[^"]*"|[^ ]+)', r'\g<1>"' + value + '"', line
            )
        lines[index] = line

in_section = False
for index, line in enumerate(lines):
    if line.startswith("["):
        in_section = line.strip() == "[icecast_titles]"
        continue
    if not in_section:
        continue

    if field in ("host", "source_port") and re.match(r"^url\s*=", line):
        match = re.match(r"^(url\s*=\s*http://)([^:/]+)(:)([0-9]+)", line)
        if match:
            host = value if field == "host" else match.group(2)
            port = value if field == "source_port" else match.group(4)
            lines[index] = f"{match.group(1)}{host}:{port}/admin/metadata"
    elif field == "password" and re.match(r"^password\s*=", line):
        lines[index] = "password = " + value
    elif field == "username" and re.match(r"^username\s*=", line):
        lines[index] = "username = " + value

with open(path, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines) + "\n")
PYTHON

    chown "$app:$app" "$file"
    chmod 400 "$file"
}

#=================================================
# ACTIONS
#=================================================

run__scan() {
    ynh_print_info "Scanning the local library..."
    ynh_hide_warnings "$cmd_file" local scan || true
}

#=================================================
# RESTART THE SERVICES WHEN SOMETHING CHANGED
#=================================================

ynh_app_config_apply() {
    _ynh_app_config_apply

    ynh_print_info "Restarting the service..."

    ynh_systemctl --service="$app" --action="restart" --log_path="systemd"
}

# Keep this last line
ynh_app_config_run $1
