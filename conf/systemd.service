[Unit]
Description=Mopidy music server
After=network.target
After=avahi-daemon.service
After=dbus.service
After=nss-lookup.target
After=pulseaudio.service
After=remote-fs.target
After=sound.target

[Service]
User=__APP__
Group=__APP__
ExecStart=__INSTALL_DIR__/venv/bin/mopidy --config __INSTALL_DIR__/__APP__.conf
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitInterval=60s

[Install]
WantedBy=multi-user.target
